# Backend HTTP port
PORT=3000

# Postgres connection string. When running via docker-compose, "db" is the Postgres service's hostname (see docker-compose.yml).
DATABASE_URL=postgresql://user:password@db:5432/tickets

# Secret used to verify JWTs. Replace with a real secret before any real deployment.
JWT_SECRET=dev-secret-change-me

# Development only. When "true", mounts POST /api/v1/dev/token, which issues a
# signed 1-hour JWT for a fixed demo identity with no authentication, so the
# widget can run end to end locally without a hand-made token. Any other value,
# including unset, leaves the route unmounted and the URL returns 404. Must stay
# false in any deployed environment.
DEV_AUTH_ENABLED=false

# Comma-separated list of origins allowed to call the API via CORS (the frontend
# widget's origin(s)). Defaults to the Vite dev server's origin if unset.
ALLOWED_ORIGINS=http://localhost:5173

# API key for the AI classification provider (Groq). Required, no default.
AI_PROVIDER_API_KEY=your-groq-api-key-here

# Base URL for the AI provider's OpenAI-compatible API. Defaults to Groq's
# endpoint if unset.
AI_PROVIDER_BASE_URL=https://api.groq.com/openai/v1

# Model name used for AI classification. Defaults to openai/gpt-oss-20b if unset.
AI_PROVIDER_MODEL=openai/gpt-oss-20b
